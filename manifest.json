{
  "id": "host-icons",
  "name": "Host Icons",
  "version": "0.2.0",
  "description": "Give each host in the Hosts list its own icon and color.",
  "author": {
    "name": "ZarenOFF",
    "url": "https://github.com/ZarenOFF"
  },
  "license": "MIT",
  "repository": "https://github.com/ZarenOFF/termix-plugin-host-icons",
  "docs": "https://github.com/ZarenOFF/termix-plugin-host-icons/tree/main/docs",
  "category": "Productivity",
  "icon": "Palette",
  "features": [
    "Pick an icon or a brand logo (Linux, Windows, Kubernetes and more) for each host",
    "Optional icon color",
    "Set a default icon for a whole folder",
    "Large icon left of the host, or small before or after the name, at the size you like",
    "Automatic icons for hosts with a tag or a name you choose"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": ["ui:surface"],
  "contributes": {
    "settings": {
      "user": [
        {
          "key": "position",
          "type": "select",
          "labelKey": "settings.user.position.label",
          "descriptionKey": "settings.user.position.description",
          "default": "large",
          "options": [
            {
              "value": "large",
              "labelKey": "settings.user.position.large"
            },
            {
              "value": "small",
              "labelKey": "settings.user.position.small"
            },
            {
              "value": "after",
              "labelKey": "settings.user.position.after"
            }
          ]
        },
        {
          "key": "size",
          "type": "custom",
          "component": "icon-size",
          "default": 100
        },
        {
          "key": "skipEmptySlot",
          "type": "boolean",
          "labelKey": "settings.user.skipEmptySlot.label",
          "descriptionKey": "settings.user.skipEmptySlot.description",
          "default": true
        },
        {
          "key": "rules",
          "type": "custom",
          "component": "icon-rules",
          "default": []
        }
      ],
      "host": {
        "fields": [
          {
            "key": "icon",
            "type": "custom",
            "component": "icon-picker",
            "default": "",
            "defaultable": true,
            "defaultLevels": ["admin", "user", "folder"]
          },
          {
            "key": "color",
            "type": "custom",
            "component": "icon-color",
            "default": "",
            "defaultable": true,
            "defaultLevels": ["admin", "user", "folder"]
          }
        ]
      }
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
